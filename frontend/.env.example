# Copy this file to `.env` and adjust if your backend runs elsewhere.
#
#   cp .env.example .env        (Git Bash / macOS / Linux)
#   copy .env.example .env      (Windows cmd)
#
# The Spring Boot API. Must be listed in `app.cors.allowed-origins` on the
# backend side for the browser to accept the response — localhost:5173 (Vite's
# default) is already allowed, so you only need to touch this if you move ports.
VITE_API_URL=http://localhost:8080
